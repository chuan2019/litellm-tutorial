# Copy to .env.local (git-ignored). No secrets go here: credentials come from
# your AWS profile. Before a live session run `aws sso login --profile <name>`
# (or `aws login --profile <name>` for console-login profiles).
# Never put AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY here; _env.py refuses them.
AWS_PROFILE=
AWS_REGION=us-west-2

# Optional: override the Bedrock models the notebooks use (LiteLLM model strings).
# MODEL_FAST=bedrock/us.anthropic.claude-haiku-5-5
# MODEL_SMART=bedrock/us.anthropic.claude-opus-5-5
# MODEL_ALT=bedrock/us.amazon.nova-2-lite-v1:0

# 1 = real Bedrock calls (costs money); anything else = offline mock responses.
LIVE=0
